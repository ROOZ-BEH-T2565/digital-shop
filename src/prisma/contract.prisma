enum ProductCategory {
  Mobile
  Laptop
  Watch
  Others
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  category    ProductCategory
  description String
  price       Float?           @default(0.0)
  quantity    Int?             @default(0)
  images      Image[]
}

model Image {
  id        Int      @id @default(autoincrement())
  image     String
  product   Product? @relation(fields: [productId], references: [id])
  productId Int?  
}